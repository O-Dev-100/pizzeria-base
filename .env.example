# ==============================================================================
# VARIABLES DE ENTORNO (PLANTILLA DIDÁCTICA)
# Copia este archivo como '.env' en la raíz antes de arrancar Docker:
# cp .env.example .env
# ==============================================================================

# 1. ENTORNO DE EJECUCIÓN
NODE_ENV=production

# 2. PUERTOS PÚBLICOS DEL SERVIDOR (EXPOSICIÓN EXTERNA)
# Puerto en el que Nginx sirve la aplicación Web y la API (Estándar HTTP / HTTPS)
HTTP_PORT=80
HTTPS_PORT=443

# Puerto en el que Nginx sirve la WebApp Móvil para Clientes en Sala (QR)
QR_PORT=8081

# Puerto para el Gestor Web Visual de Base de Datos (Adminer)
ADMINER_PORT=8082

# 3. BASE DE DATOS POSTGRESQL
# Opción A (Local / Homelab con contenedor Docker):
# DB_HOST=db
# Opción B (Cloud en AWS con Base de Datos Gestionada AWS RDS):
# DB_HOST=pizzeria-db.c123456789.us-east-1.rds.amazonaws.com
DB_HOST=db
DB_PORT=5432
DB_NAME=pizzeria_db
DB_USER=pizzeria_user
DB_PASSWORD=pizzeria_pass_2026!

# 4. BACKEND API REST (NODE.JS / EXPRESS)
BACKEND_PORT=3000
CORS_ORIGIN=*
APP_DOMAIN=pizzeria-omar.duckdns.org